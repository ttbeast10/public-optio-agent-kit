# Copy to site/deploy.env and fill it. Settings the scripts read (sourced by bash: keep the quotes).

# Kubernetes
KUBE_CONTEXT="<FILL: the Rancher cluster context>"
NAMESPACE="optio"
RELEASE="optio"

# The chart you carried in (bundle/load.sh puts it here) and its version.
OPTIO_VERSION="<FILL: e.g. 0.23.0>"
CHART="bundle/optio-${OPTIO_VERSION}.tgz"

# Where bundle/load.sh pushes: Optio's images, and mirrored third-party images.
REG_OPTIO="<FILL: registry.example.com/optio>"
REG_MIRROR="<FILL: registry.example.com/mirror>"

# Agent images with our CA (images/build-agent-ca.sh): <REG_OPTIO>/optio-agent-<preset>:<V>-<CA_TAG>
CA_TAG="ca1"
AGENT_PRESETS="base node python"
BUILDER="docker" # docker, podman or buildah

# Our CA bundle (PEM, one or more certificates) → ConfigMap optio-site-ca and the agent images.
CA_FILE="site/ca.crt"

# The public URL, and an API key for the scripts that call the API (bootstrap-db.sh, verify.sh,
# apply-config.sh --sync). Make the key in Optio: Settings → API keys. Export OPTIO_TOKEN in your
# shell; never write it here.
OPTIO_SERVER="<FILL: https://optio.example.com>"
