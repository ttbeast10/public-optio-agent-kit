# Copy to site/secrets.env (gitignored) and fill it. KEY=value, one per line, no quotes, no spaces.
# Never commit site/secrets.env. `scripts/make-k8s-objects.sh --generate` fills the empty keys marked
# (gen) with random hex and never changes a filled one.

# ── Kubernetes Secret optio-site-secrets (make-k8s-objects.sh), read through existingSecrets ──────
# (gen) Encrypts every secret Optio stores. Never change it after the first install; keep a copy
# with the backups, outside the cluster: a dump is useless without it.
OPTIO_ENCRYPTION_KEY=
# (gen) Unlocks the setup wizard while nobody can sign in yet.
OPTIO_SETUP_TOKEN=
# Deployment-wide GitLab token for repo work (a group or project access token, or a service user's).
GITLAB_TOKEN=
# (gen) The same value goes into each GitLab webhook's "Secret token".
GITLAB_WEBHOOK_SECRET=
# (gen) The same value goes into the Jira webhook's secret.
JIRA_WEBHOOK_SECRET=
# The GitLab sign-in application's secret (sign-in option A in values/values.yaml).
GITLAB_OAUTH_CLIENT_SECRET=

# ── Passed to helm by deploy.sh (the chart takes it only as a value) ─────────────────────────────
# (gen) Built-in PostgreSQL password. Hex only. Never change it after the first install.
POSTGRES_PASSWORD=

# ── Pull secret optio-registry (optional: skip when the nodes authenticate to the registry) ──────
REGISTRY_SERVER=
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# ── Database-only secrets, stored through the API by bootstrap-db.sh (DB_SECRET_<NAME>) ──────────
# The LLM gateway key Claude Code signs in with.
DB_SECRET_ANTHROPIC_API_KEY=
# The gateway's URL; reaches agent pods as the env var ANTHROPIC_BASE_URL.
DB_SECRET_ANTHROPIC_BASE_URL=
# Stops Claude Code from waiting on hosts it cannot reach.
DB_SECRET_CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
# A Jira personal access token for the Jira HTTP connection (config/connection-jira.yaml).
DB_SECRET_JIRA_PAT=
# Package mirrors agents install from (pod env; npm, pip, uv). Not secret, but pods get them this way.
DB_SECRET_NPM_CONFIG_REGISTRY=
DB_SECRET_PIP_INDEX_URL=
DB_SECRET_UV_DEFAULT_INDEX=
