# Copy to site/site.env and fill it. Not secret: commit it to the internal deploy repo.
# Every key becomes a key of the Kubernetes Secret optio-site-env (make-k8s-objects.sh) and reaches the
# API as an env var through existingSecrets in values/values.yaml.

# GitLab hosts the credential helper may answer for: exact host, or host:port when not 443.
GITLAB_HOSTS=<FILL: gitlab.example.com>
# GitLab sign-in on a self-managed server (sign-in option A).
GITLAB_OAUTH_BASE_URL=<FILL: https://gitlab.example.com>
# Our CA, mounted from the ConfigMap optio-site-ca (values: api.extraVolumes). Keep this path.
NODE_EXTRA_CA_CERTS=/etc/optio-site-ca/ca.crt
